@model EditUserViewModel
@{
    ViewData["Title"] = "Edit user";
    ViewData["BodyClass"] = "app-shell app-shell--company";
}

<div class="dashboard-header mb-4">
    <p class="text-uppercase small fw-semibold text-muted mb-1">Administrator</p>
    <h1 class="h3 mb-1 landing-font-serif">Edit user</h1>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-medium">Email</label>
                    <input asp-for="Email" class="form-control" type="email" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SchoolName" class="form-label fw-medium">Organisation name</label>
                    <input asp-for="SchoolName" class="form-control" />
                </div>
                <div class="col-12">
                    <p class="form-label fw-medium mb-2">Roles</p>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        var selected = Model.SelectedRoles.Contains(role);
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role" id="role-@role" @(selected ? "checked" : null) />
                            <label class="form-check-label" for="role-@role">@role</label>
                        </div>
                    }
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
