@model IList<AutoStockIQ.Data.Sale>
@{
    ViewData["Title"] = "Sale history";
}

<div class="dashboard-header d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
        <p class="text-uppercase small fw-semibold text-muted mb-1">Staff</p>
        <h1 class="h3 mb-1 landing-font-serif">Sale history</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="NewSale" class="btn btn-primary">New sale</a>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <p class="text-muted text-center py-4 mb-0">No sales recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-premium">
                    <thead class="table-light">
                        <tr>
                            <th>Sale</th>
                            <th>Customer</th>
                            <th>Type</th>
                            <th>Lines</th>
                            <th class="text-end">Total</th>
                            <th>When (UTC)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var sale in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@sale.SaleNumber</td>
                            <td>@sale.CustomerName</td>
                            <td>@sale.CustomerType</td>
                            <td class="small text-muted">@sale.Lines.Count</td>
                            <td class="text-end">R @sale.TotalValue.ToString("N2")</td>
                            <td class="small text-nowrap">@sale.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="Receipt" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-primary">Receipt PDF</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
