@model AutoStockIQ.Models.ViewModels.BusinessLoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Business sign in";
}

<div class="auth-card rounded-4 border bg-white p-4 p-md-5 shadow-sm">
    <p class="text-uppercase small fw-semibold text-muted mb-1">Business portal</p>
    <h1 class="h4 mb-3">Welcome back</h1>
    <p class="text-muted small mb-4">Sign in with the email your business registered. Need an account? Register first — staff use a different portal.</p>
    <form asp-controller="Business" asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-medium"></label>
            <input asp-for="Email" class="form-control form-control-lg" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-medium"></label>
            <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="mb-4 form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>
        <button type="submit" class="btn btn-business btn-lg w-100">Sign in</button>
    </form>
    <p class="mt-4 mb-0 small text-center text-muted">
        <a asp-controller="Business" asp-action="Register">Create a business account</a>
        <span class="mx-1">·</span>
        <a asp-controller="Home" asp-action="BusinessPortal">Business portal home</a>
        <span class="mx-1">·</span>
        <a asp-controller="Home" asp-action="PrivacyPolicy">Privacy Policy</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}