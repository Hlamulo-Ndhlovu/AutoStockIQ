@model IEnumerable<AutoStockIQ.Data.SchoolOrder>
@{
    ViewData["Title"] = "Order History";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3 mb-1">Order History</h1>
            <p class="text-muted mb-0">View and track your orders</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <p class="text-muted text-center py-4">No orders found. <a asp-action="Catalog">Place your first order</a></p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Items</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>#@order.Id</td>
                                    <td>@order.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge @(order.Status switch
                                        {
                                            SchoolOrderStatus.Submitted => "bg-primary",
                                            SchoolOrderStatus.Approved => "bg-success",
                                            SchoolOrderStatus.Fulfilled => "bg-info",
                                            SchoolOrderStatus.Cancelled => "bg-danger",
                                            _ => "bg-secondary"
                                        })">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td>@order.Lines.Count items</td>
                                    <td>R@order.Lines.Sum(l => l.Quantity * l.Product.UnitPrice).ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>