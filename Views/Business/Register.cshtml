@model AutoStockIQ.Models.ViewModels.BusinessRegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register your business";
}

<div class="auth-card rounded-4 border bg-white p-4 p-md-5 shadow-sm">
    <p class="text-uppercase small fw-semibold text-muted mb-1">Business portal</p>
    <h1 class="h4 mb-3">Create your business account</h1>
    <p class="text-muted small mb-4">One registration per business contact. You will use this email to sign in and place orders with Kweena Ka Bobedi.</p>
    <form asp-controller="Business" asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>
        <div class="mb-3">
            <label asp-for="BusinessName" class="form-label fw-medium"></label>
            <input asp-for="BusinessName" class="form-control form-control-lg" autocomplete="organization" />
            <span asp-validation-for="BusinessName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-medium"></label>
            <input asp-for="Email" class="form-control form-control-lg" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-medium"></label>
            <input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label fw-medium"></label>
            <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <div class="card border-0 bg-light">
                <div class="card-body p-3">
                    <div class="form-check mb-2">
                        <input asp-for="PopiaConsent" class="form-check-input" />
                        <label asp-for="PopiaConsent" class="form-check-label small fw-medium"></label>
                    </div>
                    <span asp-validation-for="PopiaConsent" class="text-danger small"></span>
                    
                    <div class="mt-2">
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" data-bs-toggle="collapse" data-bs-target="#popiaDetails" aria-expanded="false" aria-controls="popiaDetails">
                            <small class="text-muted">View POPIA Details</small>
                        </button>
                        <div class="collapse mt-2" id="popiaDetails">
                            <div class="card card-body bg-white border-0 small text-muted">
                                <p class="mb-2"><strong>Protection of Personal Information Act (POPIA)</strong></p>
                                <p class="mb-1">By consenting, you agree that Kweena Ka Bobedi may:</p>
                                <ul class="mb-0 ps-3">
                                    <li>Collect and process your business name, email, and order information</li>
                                    <li>Store your data securely for order processing and account management</li>
                                    <li>Use your data to provide stock ordering services and communication</li>
                                    <li>Retain your data as required by law and business needs</li>
                                </ul>
                                <p class="mb-0 mt-2"><small>You have the right to access, correct, or delete your personal data at any time by contacting Kweena Ka Bobedi.</small></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-business btn-lg w-100">Create account</button>
    </form>
    <p class="mt-4 mb-0 small text-center text-muted">
        <a asp-controller="Business" asp-action="Login">Already registered? Sign in</a>
        <span class="mx-1">·</span>
        <a asp-controller="Home" asp-action="BusinessPortal">Business portal home</a>
        <span class="mx-1">·</span>
        <a asp-controller="Home" asp-action="PrivacyPolicy">Privacy Policy</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}