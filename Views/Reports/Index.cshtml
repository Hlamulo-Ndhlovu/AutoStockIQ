@{
    ViewData["Title"] = "Reports";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3 mb-1">Reports</h1>
            <p class="text-muted mb-0">Generate and download PDF reports</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Stock Report</h5>
                    <p class="card-text text-muted mb-4">Generate a comprehensive report showing current inventory levels, stock valuation, and product details.</p>
                    <a asp-action="StockReport" class="btn btn-primary">Generate Stock Report</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Audit Report</h5>
                    <p class="card-text text-muted mb-4">Generate an audit log report showing all system activities, user actions, and stock movements.</p>
                    <form asp-action="AuditReport" method="get" class="row g-2">
                        <div class="col-md-6">
                            <input type="date" name="startDate" class="form-control" placeholder="Start Date" />
                        </div>
                        <div class="col-md-6">
                            <input type="date" name="endDate" class="form-control" placeholder="End Date" />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary w-100">Generate Audit Report</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>